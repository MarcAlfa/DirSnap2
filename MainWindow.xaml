<Window
    x:Class="DirSnap2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:DirSnap2.Views"
    mc:Ignorable="d"
    Title="DirSnap 2">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- 0: TabView Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Navigation Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Active Tab Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: TAB VIEW HEADER ==================== -->
        <TabView Grid.Row="0"
                 x:Name="MainTabView"
                 TabItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 AddTabButtonClick="MainTabView_AddTabButtonClick"
                 TabCloseRequested="MainTabView_TabCloseRequested">
            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem ToolTipService.ToolTip="{Binding CurrentPath}">
                        <TabViewItem.Header>
                            <Border Background="{Binding TabHeaderBackground}"
                                    BorderBrush="{Binding TabHeaderBorderBrush}"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="{Binding TabTitle}" 
                                               FontWeight="{Binding TabHeaderFontWeight}" 
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </TabViewItem.Header>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- ==================== 1: NAVIGATION TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <!-- Nav buttons -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Drive quick selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Address Bar -->
                    <ColumnDefinition Width="*" />
                    <!-- Terminal, Favorites & Recents -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Snap List Cart Button -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Theme & Settings -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Back / Forward / Up / Refresh -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Command="{Binding ActiveTab.GoBackCommand}"
                            IsEnabled="{Binding ActiveTab.CanGoBack}"
                            ToolTipService.ToolTip="Back (Alt+Left)"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>

                    <Button Command="{Binding ActiveTab.GoForwardCommand}"
                            IsEnabled="{Binding ActiveTab.CanGoForward}"
                            ToolTipService.ToolTip="Forward (Alt+Right)"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE72A;" FontSize="12" />
                    </Button>

                    <Button Command="{Binding ActiveTab.GoUpCommand}"
                            IsEnabled="{Binding ActiveTab.CanGoUp}"
                            ToolTipService.ToolTip="Up to Parent Directory (Alt+Up)"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE748;" FontSize="12" />
                    </Button>

                    <Button Command="{Binding ActiveTab.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh (F5)"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Drives Dropdown -->
                <DropDownButton Grid.Column="1" Padding="8,4" ToolTipService.ToolTip="Select Drive">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEDA2;" FontSize="12" />
                        <TextBlock Text="Drives" FontSize="12" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="DrivesMenuFlyout" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Address Bar (Path Box + Go Button) -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressTextBox"
                             Grid.Column="0"
                             Text="{Binding CurrentAddressBarPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressTextBox_KeyDown"
                             VerticalAlignment="Center"
                             FontSize="12"
                             Padding="8,5" />
                    <Button Grid.Column="1" Click="GoAddressButton_Click"
                            ToolTipService.ToolTip="Go to path (Enter)"
                            Padding="10,5" Margin="4,0,0,0" FontSize="11"
                            Style="{StaticResource AppAccentButtonStyle}">
                        <TextBlock Text="Go" FontWeight="SemiBold" Foreground="White" />
                    </Button>
                </Grid>

                <!-- Favorites & Recents Menu + Terminal -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                    <!-- Toggle Favorite Current Path -->
                    <Button Click="FavoriteCurrentPath_Click"
                            ToolTipService.ToolTip="Add/Remove current folder to Favorites"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Button>

                    <!-- Favorites & Recents Flyout -->
                    <DropDownButton Padding="8,4" ToolTipService.ToolTip="Favorites and Recent Folders">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE728;" FontSize="12" />
                            <TextBlock Text="Places" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="PlacesMenuFlyout" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Open Terminal -->
                    <Button Command="{Binding ActiveTab.OpenInTerminalCommand}"
                            ToolTipService.ToolTip="Open in Windows Terminal / PowerShell"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE756;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- ==================== SNAP LIST WIDGET ==================== -->
                <Button Grid.Column="4" x:Name="SnapListWidgetButton"
                        Style="{StaticResource AppAccentButtonStyle}"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📋 Snap List" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                        <Border Background="{ThemeResource AppBackgroundBrush}" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SnapList.Count}" 
                                       FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Snap List Pop-up Flyout -->
                    <Button.Flyout>
                        <Flyout x:Name="SnapListFlyout" Placement="BottomEdgeAlignedRight">
                            <Grid Width="380" Height="460">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Flyout Header -->
                                <Grid Grid.Row="0" Padding="0,0,0,8" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="📋 Snap List" FontWeight="SemiBold" FontSize="14" />
                                        <Border Background="{ThemeResource AppAccentBrush}" CornerRadius="10" Padding="6,1">
                                            <TextBlock Text="{Binding SnapList.Count}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="ClearSnapList_Click" Padding="6,3" Margin="0,0,6,0" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="Clear" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Detach Button -->
                                    <Button Grid.Column="2" Click="DetachSnapList_Click" ToolTipService.ToolTip="Detach into floating window" Padding="6,3" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE77A;" FontSize="11" />
                                            <TextBlock Text="Detach" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Live Formatting Toggles -->
                                <Border Grid.Row="1" Padding="0,6" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="Full path" 
                                                  IsChecked="{Binding SnapList.IncludeFullPath, Mode=TwoWay}" 
                                                  FontSize="12" />
                                        <CheckBox Content="With extension" 
                                                  IsChecked="{Binding SnapList.IncludeExtension, Mode=TwoWay}" 
                                                  FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Collected Items -->
                                <ListView Grid.Row="2"
                                          x:Name="FlyoutSnapListView"
                                          ItemsSource="{Binding SnapList.Items}"
                                          SelectionMode="Extended"
                                          KeyDown="FlyoutSnapListView_KeyDown">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Click="FlyoutRemoveItem_Click" Tag="{Binding}" Padding="4,2" MinWidth="22" Height="20" Background="Transparent" BorderThickness="0">
                                                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Export Toolbar -->
                                <Grid Grid.Row="3" Padding="0,8,0,0" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Click="FlyoutSendToNotepad_Click" HorizontalAlignment="Stretch" Margin="2" Padding="2,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                            <TextBlock Text="Notepad" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Click="FlyoutCopy_Click" HorizontalAlignment="Stretch" Margin="2" Padding="2,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            <TextBlock Text="Copy" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Click="FlyoutExportTxt_Click" HorizontalAlignment="Stretch" Margin="2" Padding="2,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                            <TextBlock Text=".txt" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3" Click="FlyoutExportCsv_Click" HorizontalAlignment="Stretch" Margin="2" Padding="2,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F9;" FontSize="11" />
                                            <TextBlock Text=".csv" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- ==================== THEME & SETTINGS BUTTON ==================== -->
                <Button Grid.Column="5" Click="SettingsButton_Click" Padding="8,4" ToolTipService.ToolTip="Settings &amp; About">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ==================== 2: ACTIVE TAB CONTENT ==================== -->
        <views:WorkspaceTabView Grid.Row="2"
                                x:Name="CurrentWorkspaceView"
                                DataContext="{Binding ActiveTab}"
                                OpenInNewTabRequested="CurrentWorkspaceView_OpenInNewTabRequested" />
    </Grid>
</Window>
