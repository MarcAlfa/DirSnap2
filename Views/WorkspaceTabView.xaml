<UserControl
    x:Class="DirSnap2.Views.WorkspaceTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:DirSnap2.Converters"
    xmlns:models="using:DirSnap2.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringMatchConverter x:Key="StringMatchConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="480" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT PANEL: NAVIGATION & FILES ==================== -->
        <Grid Grid.Column="0" x:Name="LeftPanel" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mode Switch & Action Counters -->
            <Grid Grid.Row="0" Padding="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Quick new files: empty .txt / .md named after the current date and time -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Click="NewTxtButton_Click"
                            ToolTipService.ToolTip="New .txt file in this folder (named with today's date and time)"
                            BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="TXT" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewMdButton_Click"
                            ToolTipService.ToolTip="New .md file in this folder (named with today's date and time)"
                            BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="MD" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewFolderButton_Click"
                            ToolTipService.ToolTip="New folder in this folder"
                            BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SearchBarButton" Click="SearchBarButton_Click"
                            ToolTipService.ToolTip="Show / hide the quick filter, Show all and Search in files (Ctrl+F)"
                            BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <Grid>
                            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                            <!-- Dot: "Show all" is on while the bar is hidden -->
                            <Ellipse x:Name="SearchBarDot" Width="6" Height="6" Margin="0,-3,-5,0"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Quick Counters for Snap List -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding AddAllFoldersToSnapListCommand}"
                            ToolTipService.ToolTip="Add all subfolders to Snap List"
                            BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8F4;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="{Binding FoldersCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddAllFilesToSnapListCommand}"
                            ToolTipService.ToolTip="Add all files to Snap List"
                            BorderBrush="{ThemeResource AppAccentBrush}" BorderThickness="1"
                            Padding="8,4" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8F4;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="{Binding FilesCountText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Current Folder Header Button with Tree Flyout -->
            <Button Grid.Row="1"
                    x:Name="CurrentFolderTreeButton"
                    Click="CurrentFolderTreeButton_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="{ThemeResource AppBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="0,1,0,1"
                    CornerRadius="0"
                    Padding="12,6"
                    ToolTipService.ToolTip="{Binding CurrentPath}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentFolderName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Tree" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button.Flyout>
                    <Flyout x:Name="FolderTreeFlyout" Placement="BottomEdgeAlignedLeft" Opened="FolderTreeFlyout_Opened">
                        <Grid Width="380" Height="460">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Flyout Header -->
                            <Grid Grid.Row="0" Padding="0,0,0,8" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="Folder Tree" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>

                                <Button Grid.Column="1" Click="CloseTreeFlyout_Click" Padding="6,2" FontSize="11">
                                    <TextBlock Text="Close" />
                                </Button>
                            </Grid>

                            <!-- Tree View -->
                            <TreeView Grid.Row="1"
                                      x:Name="HierarchicalTreeView"
                                      Expanding="HierarchicalTreeView_Expanding"
                                      ItemInvoked="HierarchicalTreeView_ItemInvoked"
                                      SelectionChanged="HierarchicalTreeView_SelectionChanged"
                                      DoubleTapped="HierarchicalTreeView_DoubleTapped"
                                      KeyDown="HierarchicalTreeView_KeyDown"
                                      Margin="0,6,0,0">
                                <TreeView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Height="28"
                                              Background="{Binding Content.TreeItemRowBackgroundBrush}"
                                              DoubleTapped="TreeItem_DoubleTapped"
                                              CornerRadius="4" Padding="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding Content.Glyph}" FontSize="12" 
                                                          Foreground="{Binding Content.GlyphBrush}" />
                                                <TextBlock Text="{Binding Content.Name}" 
                                                           FontWeight="{Binding Content.TreeItemFontWeight}"
                                                           Foreground="{Binding Content.TreeItemForegroundBrush}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button Grid.Column="1" 
                                                    Click="SnapTreeNode_Click"
                                                    Tag="{Binding Content}"
                                                    ToolTipService.ToolTip="Add to Snap List"
                                                    Padding="4,2" MinWidth="24" Height="22"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AppAccentBrush}" />
                                            </Button>

                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Add to Snap List" Click="Context_TreeAddToSnapList_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE710;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Open in Explorer" Click="Context_TreeOpenExplorer_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xEC50;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copy Full Path" Click="Context_TreeCopyFullPath_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Filter Bar & Show All Checkbox -->
            <!-- Hidden until the search (magnifier) button opens it; always shown while a filter is typed -->
            <Grid Grid.Row="2" x:Name="FilterBar" Padding="12,6,12,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="FilterTextBox"
                         PlaceholderText="Quick filter (*.ext or text)..."
                         KeyDown="FilterTextBox_KeyDown"
                         Text="{Binding FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <Border />
                    </TextBox.Header>
                </TextBox>

                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding ShowAll, Mode=TwoWay}"
                              Style="{StaticResource ToolbarToggleButtonStyle}" Margin="8,0,0,0"
                              Padding="8,4" FontSize="11" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Show all files, not only the ones with the editor extensions">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE890;" FontSize="11" />
                        <TextBlock Text="Show all" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Grid.Column="2" x:Name="FileSearchToggleButton" Click="FileSearchToggle_Click"
                              Style="{StaticResource ToolbarToggleButtonStyle}" Margin="4,0,0,0"
                              Padding="8,4" FontSize="11" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Search text inside the files of this folder (Ctrl+Shift+F)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8A5;" FontSize="11" />
                        <TextBlock Text="In files" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- Body: Flat List -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,1" Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="115" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding ChangeSortCommand}" CommandParameter="name"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,1">
                            <TextBlock Text="Name" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <Button Grid.Column="1" Command="{Binding ChangeSortCommand}" CommandParameter="size"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,1">
                            <TextBlock Text="Size" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <Button Grid.Column="2" Command="{Binding ChangeSortCommand}" CommandParameter="mtime"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,1">
                            <TextBlock Text="Modified" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <TextBlock Grid.Column="3" Text="Snap" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- File & Folder List -->
                <ListView Grid.Row="1"
                          x:Name="FlatListView"
                          ItemsSource="{Binding FlatItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Extended"
                          SelectionChanged="FlatListView_SelectionChanged"
                          DoubleTapped="FlatListView_DoubleTapped"
                          KeyDown="FlatListView_KeyDown">
                    <!-- Right-click on the empty part of the list -->
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Paste into this folder" Click="Context_Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="New folder" Click="Context_NewFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.Resources>
                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AppAccentSubtleBrush" />
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AppAccentSubtleBrush" />
                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AppAccentSubtleBrush" />
                        <StaticResource x:Key="ListViewItemStrokeSelected" ResourceKey="AppAccentBrush" />
                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="AppAccentBrush" />
                        <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="AppAccentBrush" />
                        <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="AppAccentBrush" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Height" Value="22" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="22" Padding="4,0" ColumnSpacing="6"
                                  Background="{Binding RowBackgroundBrush}"
                                  CornerRadius="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <!-- Name + Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="11" 
                                              Foreground="{Binding GlyphBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" 
                                               FontSize="11.5"
                                               Foreground="{Binding ItemForegroundBrush}"
                                               FontWeight="{Binding ItemFontWeight}"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Size -->
                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" 
                                           FontSize="11" 
                                           FontFamily="Consolas, Cascadia Code, Courier New"
                                           Foreground="{Binding DetailsForegroundBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- Modified Date -->
                                <TextBlock Grid.Column="2" Text="{Binding FormattedModifiedTime}" 
                                           FontSize="10.5" 
                                           FontFamily="Consolas, Cascadia Code, Courier New"
                                           Foreground="{Binding DetailsForegroundBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <!-- Quick [+] Button -->
                                <Button Grid.Column="3" 
                                        Click="SnapItem_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Add to Snap List"
                                        Padding="0" MinWidth="20" Height="18"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource AppAccentBrush}" />
                                </Button>

                                <!-- Context Menu -->
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Add to Snap List" Click="Context_AddToSnapList_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Cut" Click="Context_Cut_Click" KeyboardAcceleratorTextOverride="Ctrl+X">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C6;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy" Click="Context_Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Paste into this folder" Click="Context_Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Duplicate" Click="Context_Duplicate_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF413;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Rename" Click="Context_Rename_Click" KeyboardAcceleratorTextOverride="F2">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Delete" Click="Context_Delete_Click" KeyboardAcceleratorTextOverride="Del">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Folder info (size, files)" Click="Context_FolderInfo_Click" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open in New Tab" Click="Context_OpenInNewTab_Click" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open in Explorer" Click="Context_OpenExplorer_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEC50;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open in Terminal" Click="Context_OpenTerminal_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE756;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy Full Path" Click="Context_CopyFullPath_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy WSL Path" Click="Context_CopyWslPath_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Search in files: covers the file list while open -->
            <Grid Grid.Row="3" x:Name="FileSearchPanel" Visibility="Collapsed"
                  Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="10,4,4,4" ColumnSpacing="6" Background="{ThemeResource AppBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Search in files" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="FileSearchClose_Click"
                            Padding="6,2" Background="Transparent" BorderThickness="0" CornerRadius="4"
                            ToolTipService.ToolTip="Close the search (Esc) and go back to the file list">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Query -->
                <Grid Grid.Row="1" Padding="10,8,10,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="FileSearchTextBox"
                             PlaceholderText="Text to find in the files of this folder..."
                             KeyDown="FileSearchTextBox_KeyDown" />
                    <Button Grid.Column="1" x:Name="FileSearchGoButton" Click="FileSearchGo_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="10,5"
                            ToolTipService.ToolTip="Search (Enter)">
                        <FontIcon x:Name="FileSearchGoIcon" Glyph="&#xE721;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Options -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Padding="10,0,10,4">
                    <CheckBox x:Name="FileSearchSubfoldersCheck" Content="Subfolders" FontSize="12" MinWidth="0"
                              Click="FileSearchOption_Click" />
                    <ToggleButton x:Name="FileSearchMatchCaseToggle" Content="Aa" FontSize="11" Padding="8,3"
                                  Style="{StaticResource ToolbarToggleButtonStyle}" VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Match case" Click="FileSearchOption_Click" />
                </StackPanel>

                <!-- Status: what was searched, how many results -->
                <TextBlock Grid.Row="3" x:Name="FileSearchStatusText" Margin="10,0,10,6" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Results: one row per file, then its matching lines -->
                <ListView Grid.Row="4" x:Name="FileSearchListView"
                          BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0"
                          SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="FileSearchListView_ItemClick"
                          KeyDown="FileSearchListView_KeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileSearchHit">
                            <Grid Height="20" Padding="4,0" ToolTipService.ToolTip="{x:Bind ToolTip}">
                                <!-- File row -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind HeaderVisibility}">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="{x:Bind FileName}" FontSize="11.5" FontWeight="SemiBold"
                                               FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind HeaderDetail}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Matching line -->
                                <Grid ColumnSpacing="8" Padding="16,0,0,0" Visibility="{x:Bind LineVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind LineNumberText}" FontSize="10.5" HorizontalAlignment="Right"
                                               FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center">
                                        <Run Text="{x:Bind Before}" /><Run Text="{x:Bind Match}" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" /><Run Text="{x:Bind After}" />
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Folder Contents panel: files and subfolders of the folder selected in the list -->
            <Grid Grid.Row="4" x:Name="FolderPeekPanel"
                  Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drag handle on the top edge: resizes the panel (height saved in config) -->
                <Border Grid.Row="0" x:Name="FolderPeekSplitter" Height="6" Margin="0,-3,0,0" VerticalAlignment="Top"
                        Background="Transparent" Canvas.ZIndex="1"
                        PointerEntered="FolderPeekSplitter_PointerEntered"
                        PointerExited="FolderPeekSplitter_PointerExited"
                        PointerPressed="FolderPeekSplitter_PointerPressed"
                        PointerMoved="FolderPeekSplitter_PointerMoved"
                        PointerReleased="FolderPeekSplitter_PointerReleased"
                        PointerCaptureLost="FolderPeekSplitter_PointerCaptureLost" />

                <!-- Header -->
                <Grid Grid.Row="0" Padding="10,4,4,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="FolderPeekTitle" Text="Folder contents" FontSize="11.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="FolderPeekCollapseButton" Click="FolderPeekCollapse_Click"
                            Padding="6,2" Background="Transparent" BorderThickness="0" CornerRadius="4"
                            ToolTipService.ToolTip="Hide / show the folder contents">
                        <FontIcon x:Name="FolderPeekCollapseIcon" Glyph="&#xE70D;" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1" x:Name="FolderPeekBody" Height="160" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="FolderPeekHint" Margin="12,8" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Select a folder in the list to see its files here." />
                    <ListView x:Name="FolderPeekListView"
                              SelectionMode="Single"
                              Visibility="Collapsed"
                              DoubleTapped="FolderPeekListView_DoubleTapped"
                              KeyDown="FolderPeekListView_KeyDown">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="20" />
                                <Setter Property="Height" Value="20" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="20" Padding="4,0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="115" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="11" Foreground="{Binding GlyphBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                   Foreground="{Binding ItemForegroundBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="10.5"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               Foreground="{Binding DetailsForegroundBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedModifiedTime}" FontSize="10"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               Foreground="{Binding DetailsForegroundBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Bottom Left Info Bar: Always shows folder totals -->
            <Border Grid.Row="5" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FolderSummaryText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <!-- Multiple selection (Ctrl/Shift + click): how many items the actions apply to -->
                    <TextBlock Grid.Column="1" x:Name="SelectionCountText" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppAccentBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== SPLITTER ==================== -->
        <Border Grid.Column="1" x:Name="SplitterBorder"
                Background="Transparent" 
                PointerEntered="Splitter_PointerEntered"
                PointerExited="Splitter_PointerExited"
                PointerPressed="Splitter_PointerPressed"
                PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased">
            <Border Width="1" Background="{ThemeResource AppBorderBrush}" HorizontalAlignment="Center" />
        </Border>

        <!-- ==================== RIGHT PANEL: TEXT EDITOR ==================== -->
        <Grid Grid.Column="2" x:Name="EditorPanel" Background="{ThemeResource AppSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Editor Header & Toolbar -->
            <Border Grid.Row="0" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Opened File Name & Lock Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                        <TextBlock Text="{Binding CurrentEditingFileName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFD166" VerticalAlignment="Center" />

                        <!-- Dirty star -->
                        <TextBlock Text="*" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="Bold" FontSize="15" 
                                   Visibility="{Binding IsEditorDirty, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Read-only lock indicator -->
                        <Border Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding IsReadOnlyBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Read-Only" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CurrentEditingFileSizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Editor Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <!-- Left to right: Save / Format JSON (only when useful), then unlock, find, copy, wrap, outline (rightmost) -->
                        <!-- Save Button (Only visible after an edit) -->
                        <Button Command="{Binding SaveEditorFileCommand}"
                                ToolTipService.ToolTip="Save File (Ctrl+S)"
                                Padding="10,4" FontSize="11"
                                Visibility="{Binding IsEditorDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource AppAccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>

                        <!-- Format JSON Button -->
                        <Button Command="{Binding FormatJsonCommand}"
                                Visibility="{Binding CanFormatJson, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Format &amp; Beautify JSON"
                                Padding="8,4" FontSize="11"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE943;" FontSize="11" />
                                <TextBlock Text="Format JSON" />
                            </StackPanel>
                        </Button>

                        <!-- Edit / Unlock Toggle (Only visible for text preview/edit; lights up when in edit mode) -->
                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding IsEditingEnabled, Mode=TwoWay}"
                                      Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTipService.ToolTip="{Binding EditModeToolTip}">
                            <FontIcon Glyph="&#xE785;" FontSize="12" />
                        </ToggleButton>

                        <!-- Find in file (Ctrl+F while the preview has focus) -->
                        <Button Click="FindButton_Click"
                                Visibility="{Binding IsPreviewUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Find in file (Ctrl+F in the preview, F3 next)"
                                Padding="7,4" FontSize="11"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Copy All Text Button (Only visible for text preview/edit) -->
                        <Button Click="CopyEditorTextButton_Click"
                                Visibility="{Binding IsPreviewUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Copy all text to clipboard"
                                Padding="7,4" FontSize="11"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>

                        <!-- Word Wrap Toggle (Only visible for text preview/edit; lights up when active) -->
                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding EditorWrap, Mode=TwoWay}"
                                      Visibility="{Binding IsPreviewUnlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                      ToolTipService.ToolTip="{Binding WordWrapToolTip}">
                            <FontIcon Glyph="&#xEE43;" FontSize="12" />
                        </ToggleButton>

                        <!-- Outline panel toggle (functions / classes / headings) -->
                        <ToggleButton x:Name="OutlineToggleButton"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Click="OutlineToggleButton_Click"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="Show / hide the outline (functions, classes, headings)">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Find Bar (search inside the preview / editor, also in read-only mode) -->
            <Border Grid.Row="1" x:Name="FindBar" Visibility="Collapsed"
                    Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="FindTextBox"
                             Width="260" MinHeight="28" Padding="8,4" FontSize="12"
                             PlaceholderText="Find in file..."
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown" />
                    <TextBlock x:Name="FindCountText" MinWidth="70" FontSize="11" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleButton x:Name="FindMatchCaseToggle"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Click="FindMatchCaseToggle_Click"
                                  ToolTipService.ToolTip="Match case">
                        <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" />
                    </ToggleButton>
                    <Button Click="FindPrevious_Click" ToolTipService.ToolTip="Previous match (Shift+F3, Shift+Enter)"
                            Padding="7,4" Background="Transparent" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <FontIcon Glyph="&#xE70E;" FontSize="11" />
                    </Button>
                    <Button Click="FindNext_Click" ToolTipService.ToolTip="Next match (F3, Enter)"
                            Padding="7,4" Background="Transparent" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <FontIcon Glyph="&#xE70D;" FontSize="11" />
                    </Button>
                    <Button Click="FindClose_Click" ToolTipService.ToolTip="Close (Esc)"
                            Padding="7,4" Background="Transparent" BorderThickness="0" CornerRadius="4">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Editor Content (Body with 3 states) + Outline panel on the right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- State 1: No file selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{Binding HasActiveFile, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='inverse'}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="42" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No file selected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a file from the list or tree to preview or edit." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- State 2: Non-configured file pending unlock / Binary file notice -->
                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="28,20" MaxWidth="440"
                        Visibility="{Binding RequiresPreviewUnlock, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="{Binding PreviewNoticeGlyph}" FontSize="38" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentEditingFileName}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentEditingFileSizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PreviewNoticeText}"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Command="{Binding UnlockPreviewCommand}"
                                Visibility="{Binding CanUnlockPreview, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource AppAccentButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,6,0,0" Padding="16,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE785;" FontSize="12" />
                                <TextBlock Text="Unlock Preview" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- State 3A: Syntax-Colored Markdown Viewer (Read-Only Preview) -->
                <ScrollViewer x:Name="MarkdownScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              Padding="16"
                              Visibility="Collapsed">
                    <RichTextBlock x:Name="MarkdownRichTextBlock"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="{Binding EditorTextWrapping}"
                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                   FontSize="{Binding EditorFontSize}" />
                </ScrollViewer>

                <!-- State 3B: Raw / Editable Editor Content (Monospace TextBox) -->
                <TextBox x:Name="EditorTextBox"
                         Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsEditorLocked}"
                         TextWrapping="{Binding EditorTextWrapping}"
                         AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollMode="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollMode="Auto"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="{Binding EditorFontSize}"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                         Padding="12"
                         BorderThickness="0"
                         Background="Transparent"
                         KeyDown="EditorTextBox_KeyDown"
                         TextChanged="EditorTextBox_TextChanged"
                         Visibility="Collapsed" />

                <!-- Scroll to Top floating button (appears when scrolled down, like on websites) -->
                <Button x:Name="ScrollToTopButton"
                        Click="ScrollToTopButton_Click"
                        ToolTipService.ToolTip="Scroll to top"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,20"
                        Visibility="Collapsed"
                        Style="{StaticResource AppAccentButtonStyle}"
                        CornerRadius="14"
                        Padding="9,5"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74A;" FontSize="11" />
                        <TextBlock Text="TOP" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Outline Panel: functions / classes / procedures / headings of the open file -->
                <Grid Grid.Column="1" x:Name="OutlinePanel" Width="230" Visibility="Collapsed"
                      Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="10,6,4,6" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="Outline" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="OutlineCountText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OutlineClose_Click" ToolTipService.ToolTip="Close the outline"
                                Padding="6,3" Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="OutlineEmptyText" Text="No functions found"
                               Margin="12" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <ListView Grid.Row="1" x:Name="OutlineListView"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OutlineListView_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="6" ToolTipService.ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="{Binding Indent}" VerticalAlignment="Center">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="10" Foreground="{ThemeResource AppAccentBrush}" />
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LineText}" FontSize="10"
                                               FontFamily="Consolas, Cascadia Code, Courier New"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Drag handle on the left edge: resizes the outline panel (width saved in config) -->
                    <Border Grid.RowSpan="2" x:Name="OutlineSplitter"
                            Width="6" HorizontalAlignment="Left" Margin="-3,0,0,0"
                            Background="Transparent"
                            PointerEntered="Splitter_PointerEntered"
                            PointerExited="Splitter_PointerExited"
                            PointerPressed="OutlineSplitter_PointerPressed"
                            PointerMoved="OutlineSplitter_PointerMoved"
                            PointerReleased="OutlineSplitter_PointerReleased"
                            PointerCaptureLost="OutlineSplitter_PointerCaptureLost" />
                </Grid>
            </Grid>

            <!-- Editor Status Footer -->
            <Border Grid.Row="3" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Path, then the line counter right after it (the path gets trimmed when space is short: see UpdateFooterPathWidth) -->
                    <StackPanel Grid.Column="0" x:Name="FooterLeftPanel" Orientation="Horizontal" Spacing="16" SizeChanged="Footer_SizeChanged">
                        <TextBlock x:Name="FooterPathText" Text="{Binding CurrentEditingFilePath}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <!-- Caret line / total lines; click (or Ctrl+G) to go to a line -->
                        <TextBlock x:Name="FooterLineText" FontSize="11" Visibility="Collapsed"
                                   Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold"
                                   Tapped="FooterLineText_Tapped" SizeChanged="Footer_SizeChanged"
                                   ToolTipService.ToolTip="Go to line (Ctrl+G)" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" x:Name="FooterRightPanel" Orientation="Horizontal" Spacing="16" SizeChanged="Footer_SizeChanged">
                        <TextBlock Text="{Binding EditorEncodingName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding EditorNewlineName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
