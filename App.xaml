<Application
    x:Class="DirSnap2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Default (Dark) Theme Dictionary -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                </ResourceDictionary>

                <!-- Dark Theme Dictionary Alias -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                </ResourceDictionary>

                <!-- Light Theme Dictionary -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D8DCE2" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F2328" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#59636E" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C959F" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8C959F" />

                    <!-- Standard Button & ToggleButton PointerOver & Pressed states for Light mode -->
                    <!-- Normal buttons in light mode should hover to a clear light-gray tint (#E2E5EA), never white (#FFFFFF) -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E5EA" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D5D9E0" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1F2328" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1F2328" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1F2328" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD0D8" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B8BFC9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A6B0BC" />

                    <!-- ToggleButton resources -->
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E2E5EA" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#D5D9E0" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#1F2328" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#1F2328" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#1F2328" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#CBD0D8" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#B8BFC9" />

                    <!-- Subtle control fill overrides so transparent/subtle buttons don't turn bright white -->
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#2E000000" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E2E5EA" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#D5D9E0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />

            <!--
                Accent button with its own template so that PointerOver/Pressed never fall back to the
                generic ButtonBackgroundPointerOver (light gray in Light theme) nor to dark foreground.
                Hover/pressed feedback is a dark overlay on top of the button's own Background, so it works
                identically in Dark and Light themes and for buttons whose Background is set in code.
            -->
            <Style x:Key="AppAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="11,5,11,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="StateOverlay"
                                        Background="Black"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="StateOverlay.Opacity" Value="0.16" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="StateOverlay.Opacity" Value="0.30" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Toolbar toggle button (e.g. Edit mode, Word Wrap) that lights up with AppAccentBrush
                and white foreground when checked, and stays subtle / neutral when unchecked.
            -->
            <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="ActiveBackground"
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />
                                <Border x:Name="HoverOverlay"
                                        Background="{ThemeResource TextFillColorPrimaryBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.12" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.24" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="1" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0" />
                                                <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="1" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.16" />
                                                <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="1" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.28" />
                                                <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0.6" />
                                                <Setter Target="ContentPresenter.Foreground" Value="White" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.12" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <VisualState.Setters>
                                                <Setter Target="ActiveBackground.Opacity" Value="0" />
                                                <Setter Target="HoverOverlay.Opacity" Value="0.24" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
