<Application
    x:Class="DirSnap2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Default (Dark) Theme Dictionary -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                </ResourceDictionary>

                <!-- Dark Theme Dictionary Alias -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                </ResourceDictionary>

                <!-- Light Theme Dictionary -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D8DCE2" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
                    <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#260078D4" />
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TabViewItemStrokeSelected" Color="#0078D4" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1F2328" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#59636E" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C959F" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8C959F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#106EBE" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#260078D4" />

            <Style x:Key="AppAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
